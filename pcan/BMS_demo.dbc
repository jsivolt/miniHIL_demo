CM_ BO_ 512
 "Debug command frame. CAN ID 0x200.";

CM_ BO_ 513
 "BMS control command frame. CAN ID 0x201.";


CM_ BO_ 768
 "BMS general status frame. CAN ID 0x300.";

CM_ SG_ 768 Pack1_Temperature
 "Pack 1 NTC temperature. Signed 16-bit little-endian, 0.1 degC/bit.";

CM_ SG_ 768 Pack2_Temperature
 "Pack 2 NTC temperature. Signed 16-bit little-endian, 0.1 degC/bit.";

CM_ SG_ 768 Pack3_Temperature
 "Pack 3 NTC temperature. Signed 16-bit little-endian, 0.1 degC/bit.";

CM_ SG_ 768 CriticalFault
 "1 when a critical fault is active.";

CM_ SG_ 768 AnyFault
 "1 when any BMS fault is active.";


CM_ BO_ 769
 "Pack voltage and Battery Monitor status frame. CAN ID 0x301.";

CM_ SG_ 769 Pack1Voltage
 "Pack 1 voltage. Unsigned 16-bit little-endian, 0.1 V/bit.";

CM_ SG_ 769 Pack2Voltage
 "Pack 2 voltage. Unsigned 16-bit little-endian, 0.1 V/bit.";

CM_ SG_ 769 Pack3Voltage
 "Pack 3 voltage. Unsigned 16-bit little-endian, 0.1 V/bit.";

CM_ SG_ 769 BatteryMonitorStatus
 "BatteryMonitor status in byte 6 bits 0-3.";

CM_ SG_ 769 PackStatusAliveCounter
 "4-bit rolling alive counter in byte 6 bits 4-7.";

CM_ SG_ 769 PackVoltageValid
 "Overall pack voltage validity in byte 7 bit 0.";


CM_ BO_ 770
 "Three-pack contactor status frame. CAN ID 0x302.";

CM_ SG_ 770 ContactorAliveCounter
 "4-bit rolling alive counter in byte 6 bits 0-3.";


CM_ BO_ 771
 "Pack 1 and Pack 2 fault masks. CAN ID 0x303. Bytes 0-3 = Pack1FaultMask, bytes 4-7 = Pack2FaultMask.";

CM_ SG_ 771 Pack1FaultMask
 "Raw 32-bit Pack 1 fault mask, little-endian.";

CM_ SG_ 771 Pack2FaultMask
 "Raw 32-bit Pack 2 fault mask, little-endian.";


CM_ BO_ 772
 "Pack 3 and System fault masks. CAN ID 0x304. Bytes 0-3 = Pack3FaultMask, bytes 4-7 = SystemFaultMask.";

CM_ SG_ 772 Pack3FaultMask
 "Raw 32-bit Pack 3 fault mask, little-endian.";

CM_ SG_ 772 SystemFaultMask
 "Raw 32-bit System fault mask, little-endian.";

